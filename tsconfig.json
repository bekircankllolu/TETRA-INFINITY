{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@core/*": ["./src/core/*"],
      "@state/*": ["./src/state/*"],
      "@ui/*": ["./src/ui/*"],
      "@input/*": ["./src/input/*"],
      "@hooks/*": ["./src/hooks/*"]
    }
  }
}
